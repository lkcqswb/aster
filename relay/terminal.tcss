Screen { background: #101713; color: #dce3d6; }
#topbar { height: 3; padding: 0 2; background: #1c281f; align-vertical: middle; }
#brand { width: 13; color: #c0dba0; text-style: bold; height: 1; }
#wordmark { width: 1fr; height: 1; color: #85937e; }
#connection { width: auto; height: 1; color: #acc38e; }
#body { height: 1fr; }
#sidebar { width: 30; background: #151e18; padding: 1 2; border-right: solid #2a3a2d; }
#workspace-label { color: #b2c49e; height: 2; text-style: bold; }
.eyebrow { color: #788b73; height: 1; margin: 1 0; text-style: bold; }
#history { height: 1fr; min-height: 4; border: none; padding: 0; background: transparent; scrollbar-size: 1 1; }
OptionList > .option-list--option-highlighted { background: #2c3d2d; color: #dbeacb; text-style: none; }
OptionList > .option-list--option-hover { background: #233125; }
#companion-box { height: 17; margin-top: 1; }
#portrait { height: 12; width: 24; }
#companion-status { height: 1; margin-top: 1; color: #a4bc8c; }
#sidebar-foot { height: 1; margin-top: 1; color: #5b705b; text-align: center; }
#workbench { width: 1fr; padding: 1 2 0 2; }
#run-heading { height: 2; color: #e0e8d7; text-style: bold; padding-top: 0; }
#run-meta { height: 2; color: #8b9d80; }
#toolbar { height: 3; margin: 0 0 1 0; }
Button { min-width: 12; height: 3; background: #1c2b20; color: #b1c69d; border: tall #33462f; margin-right: 1; }
Button:hover { background: #30472f; color: #e0f0cd; }
Button:focus { text-style: bold; border: tall #91ac77; background: #30432d; }
Button:disabled { color: #58694f; background: #19231b; border: tall #243021; }
Button.-primary { background: #b5ce94; color: #1d2c19; border: tall #b5ce94; text-style: bold; }
Button.-primary:focus { background: #d1e3b4; border: tall #d1e3b4; color: #182512; }
Button.-error { background: #63443a; color: #efd4c4; border: tall #85604e; }
#pages { height: 1fr; }
Tabs { background: #101713; }
Tab { background: #101713; color: #788b71; padding: 0 2; }
Tab.-active { color: #c3dba5; text-style: bold; }
Underline { color: #8da775; background: #22301f; }
TabPane { padding: 1 0 0 0; }
RichLog { background: #151c19; color: #dce3d6; border: round #2e3d30; padding: 1 2; scrollbar-size: 1 1; scrollbar-color: #4d6245; scrollbar-background: #182019; }
RichLog:focus { border: round #61774f; }
#timeline, #checks, #task-content { height: 1fr; }
#file-browser { height: 1fr; }
#files { width: 24; background: #151c19; border: round #2e3d30; margin-right: 1; padding: 1 0; }
#file-content { width: 1fr; }
#budget { height: 2; padding-top: 1; color: #879d79; }
#notice { height: 2; color: #839776; padding-top: 0; }
Footer { background: #233120; color: #a4b48d; }
Footer > .footer--key { background: #33462c; color: #d4e5b9; text-style: bold; }
Footer > .footer--description { color: #9bab8a; }
ModalScreen { align: center middle; background: #080c09 75%; }
#dialog { width: 76; max-width: 95%; height: auto; max-height: 95%; background: #17221a; border: round #526b42; padding: 1 3; }
.run-dialog { height: 44; }
.modal-title { height: 2; color: #dce9cf; text-style: bold; }
#form-scroll { height: auto; max-height: 32; padding-right: 1; scrollbar-size: 1 1; }
.hint { color: #8b9e7c; height: auto; margin: 0 0 1 0; }
.field-row { height: auto; }
.field { width: 1fr; height: auto; margin-right: 1; }
Label { color: #a3b391; height: 1; margin: 0 0 1 0; }
Input { height: 3; margin-bottom: 1; border: tall #35472e; background: #101910; color: #d6e4c7; }
Input:focus { border: tall #8aa96c; }
Select { height: 3; margin-bottom: 1; }
SelectCurrent { background: #101910; color: #c3d6af; border: tall #35472e; }
Select:focus SelectCurrent { border: tall #8aa96c; }
SelectOverlay { background: #25351f; color: #d5e7c0; border: tall #77955c; }
TextArea { height: 6; margin-bottom: 1; border: round #35472e; background: #101910; color: #d6e4c7; }
#custom-fields { height: auto; }
.dialog-actions { height: 3; margin-top: 1; align-horizontal: right; dock: bottom; }
.error-text { height: auto; color: #d8a18d; }
#quit-dialog { width: 66; max-width: 95%; height: auto; background: #17221a; border: round #526b42; padding: 2 3; }
.compact #workbench { padding: 1 1 0 1; }
.compact #sidebar { width: 29; }
.compact #connection { display: none; }
.compact #files { width: 20; }
.compact #toolbar Button { min-width: 10; margin-right: 1; }
.compact #run-meta { height: 2; }
.short #topbar { height: 1; }
.short #workbench { padding-top: 0; }
.short #run-heading { height: 1; }
.short #run-meta { height: 1; }
.short #toolbar { margin: 0; }
.short #budget { height: 1; padding: 0; }
.short #notice { height: 1; }
.short RichLog { padding: 0 1; }
